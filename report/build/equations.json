{
 "crate": "I_{1C} = \\dfrac{Q_{\\mathrm{nominal}}}{1\\ \\mathrm{h}}, \\qquad I_{xC} = x\\, I_{1C}",
 "voltage_parts": "V(t) = \\left(U_{+} - U_{-}\\right)_{\\mathrm{OCV}} \\; - \\; \\eta_{\\mathrm{kin}} \\; - \\; I R_{\\mathrm{ohm}} \\; - \\; \\eta_{\\mathrm{conc}}",
 "fick": "\\dfrac{\\partial c_s}{\\partial t} = \\dfrac{1}{r^2}\\,\\dfrac{\\partial}{\\partial r}\\left(r^2 D_s \\dfrac{\\partial c_s}{\\partial r}\\right), \\qquad -D_s\\dfrac{\\partial c_s}{\\partial r} = \\dfrac{j}{F}\\ \\ \\mathrm{at}\\ r = R_p",
 "salt": "\\varepsilon\\,\\dfrac{\\partial c_e}{\\partial t} = \\dfrac{\\partial}{\\partial x}\\left(D_e^{\\mathrm{eff}}\\,\\dfrac{\\partial c_e}{\\partial x}\\right) + (1-t_+)\\,\\dfrac{a\\,j}{F}",
 "ohm_s": "\\dfrac{\\partial}{\\partial x}\\left(\\sigma^{\\mathrm{eff}}\\,\\dfrac{\\partial \\phi_s}{\\partial x}\\right) = a\\,j",
 "ohm_e": "\\dfrac{\\partial}{\\partial x}\\left(\\kappa^{\\mathrm{eff}}\\,\\dfrac{\\partial \\phi_e}{\\partial x} - \\kappa^{\\mathrm{eff}}\\,\\dfrac{2RT}{F}\\,(1-t_+)\\,\\dfrac{\\partial \\ln c_e}{\\partial x}\\right) = -\\,a\\,j",
 "bv": "j = 2\\,j_0\\,\\sinh\\left(\\dfrac{F\\,\\eta}{2RT}\\right), \\qquad \\eta = \\phi_s - \\phi_e - U(\\theta_{\\mathrm{surf}}), \\qquad \\theta = \\dfrac{c_s}{c_{s,\\max}}",
 "j0": "j_0 = k\\,\\sqrt{c_e\\; c_{s,\\mathrm{surf}}\\,\\left(c_{s,\\max} - c_{s,\\mathrm{surf}}\\right)}",
 "cellV": "V(t) = \\phi_s(x = L) - \\phi_s(x = 0)",
 "bruggeman": "D_e^{\\mathrm{eff}} = \\varepsilon^{1.5}\\,D_e, \\qquad \\kappa^{\\mathrm{eff}} = \\varepsilon^{1.5}\\,\\kappa, \\qquad a = \\dfrac{3\\,\\varepsilon_{\\mathrm{am}}}{R_p}",
 "layer": "\\mathbf{h}_{k+1} = \\tanh\\left(\\mathbf{W}_k\\,\\mathbf{h}_k + \\mathbf{b}_k\\right), \\qquad \\mathbf{h}_0 = (x,\\ t)",
 "gd": "\\mathbf{w}\\ \\leftarrow\\ \\mathbf{w} - \\alpha\\,\\nabla_{\\mathbf{w}}\\,\\mathcal{L}(\\mathbf{w})",
 "residual_example": "r(x,t) = \\dfrac{\\partial c_{NN}}{\\partial t} - D\\,\\dfrac{\\partial^2 c_{NN}}{\\partial x^2} \\qquad (=0\\ \\mathrm{for\\ the\\ exact\\ solution})",
 "loss": "\\mathcal{L}(\\mathbf{w}) = \\sum_{g}\\ \\lambda_g\\,\\dfrac{1}{N_g}\\sum_{i=1}^{N_g} r_g(x_i,t_i;\\mathbf{w})^2 \\;+\\; \\lambda_d\\,\\dfrac{1}{M}\\sum_{m=1}^{M}\\left(\\dfrac{V_{\\mathrm{PINN}}(t_m) - V_{\\mathrm{data}}(t_m)}{\\sigma}\\right)^2",
 "hard_ic": "c(x,t) = c_0 + \\left(1 - e^{-t/\\tau}\\right)\\,N_{\\mathbf{w}}(x,t) \\qquad \\Rightarrow \\qquad c(x,0) = c_0\\ \\ \\mathrm{always}",
 "scaling": "\\hat{t} = \\dfrac{t}{t_{\\mathrm{end}}}, \\qquad \\hat{x} = \\dfrac{x}{L}, \\qquad \\hat{r} = \\dfrac{r}{\\mathrm{typical\\ size\\ of\\ the\\ term}}",
 "fourier": "\\mathrm{time\\ features:}\\ \\ \\left(\\hat t,\\ \\sin 2\\pi\\hat t,\\ \\cos 2\\pi\\hat t,\\ \\ldots,\\ \\sin 2\\pi K\\hat t,\\ \\cos 2\\pi K\\hat t,\\ e^{-t/60\\,\\mathrm{s}},\\ e^{-t/600\\,\\mathrm{s}}\\right)",
 "sens": "S_i(t) = \\dfrac{\\partial V(t)}{\\partial \\ln p_i} \\approx \\dfrac{V(t;\\ p_i e^{+h}) - V(t;\\ p_i e^{-h})}{2h}",
 "fisher": "\\mathbf{F} = \\dfrac{1}{\\sigma^2}\\,\\mathbf{S}\\,\\mathbf{S}^{T}, \\qquad \\mathrm{std}(\\ln p_i)\\ \\geq\\ \\sqrt{\\left(\\mathbf{F}^{-1}\\right)_{ii}}\\qquad (\\mathrm{Cramer\\ Rao\\ bound})",
 "bias": "\\delta\\mathbf{p}\\ \\approx\\ -\\left(\\mathbf{S}\\,\\mathbf{S}^{T}\\right)^{-1}\\mathbf{S}\\;\\mathbf{e}, \\qquad e(t) = V_{\\mathrm{PINN}}(t) - V_{\\mathrm{exact}}(t)",
 "stress": "D(c) = D_0\\,\\left(1 + \\theta_M\\,c\\right)",
 "lli_lam": "\\mathrm{LLI}:\\ \\theta_{n,0}\\ \\downarrow \\qquad \\mathrm{LAM}:\\ \\varepsilon_{\\mathrm{am}}\\ \\downarrow \\qquad \\mathrm{capacity} \\propto \\varepsilon_{\\mathrm{am},n}\\,\\theta_{n,0}",
 "span_rate": "r_m = k_m\\left[\\sqrt{a_{\\mathrm{educt}}}\\;e^{-x_m} \\;-\\; \\sqrt{a_{\\mathrm{products}}}\\;e^{+x_m}\\right], \\qquad x_m = \\dfrac{F}{2RT}\\left(\\Delta\\phi - U_m\\right)",
 "span_U": "U_m = U_m^{0} - b_m\\,\\left(1 - a_m\\right), \\qquad a_m = \\dfrac{c_m}{c_{\\mathrm{ref}}}",
 "span_tafel": "r_m\\ \\approx\\ k_m\\,\\sqrt{a_m}\\;\\exp\\left(-\\dfrac{F}{2RT}\\left(\\Delta\\phi - U_m\\right)\\right)",
 "span_extents": "\\dfrac{\\partial \\xi_m}{\\partial t} = \\dfrac{a\\,r_m}{2\\,c_0}\\quad (m = 1,2,3), \\qquad c_{S_4} = c_0(1-\\xi_1),\\ \\ c_{S_3} = c_0(\\xi_1-\\xi_2),\\ \\ c_{S_2} = c_0(\\xi_2-\\xi_3),\\ \\ c_{S_1} = c_0(\\xi_1+\\xi_3)",
 "span_current": "\\int_0^{L_{\\mathrm{cat}}} F\\,a\\,\\left(r_1 + r_2 + r_3\\right)\\,dy = I(t)",
 "span_li2s": "r_L = \\dfrac{k_L}{\\sqrt{K_{sp}}}\\left(a_{Li^{+}}\\,a_{S^{2-}} - K_{sp}\\right)\\qquad (>0:\\ \\mathrm{Li_2S\\ precipitates})",
 "span_V": "V(t) = \\Delta\\phi(y = 0,\\,t) + \\phi_e(y = 0,\\,t) - Z_{CC}\\,I(t)",
 "span_hard_extents": "e_m = \\exp\\left(-\\hat t\\;P_m(y,\\hat t)\\right),\\qquad \\xi_1 = 1 - e_1,\\quad \\xi_2 = \\xi_1\\,(1 - e_2),\\quad \\xi_3 = \\xi_2\\,(1 - e_3)",
 "span_projection": "R(y,t) = \\dfrac{I(t)}{F\\,L_{\\mathrm{cat}}}\\ \\dfrac{\\rho(y,t)}{\\int_0^1 a\\,\\rho\\;dY}\\qquad \\Rightarrow\\qquad \\int_0^{L_{\\mathrm{cat}}} F\\,a\\,R\\,dy = I(t)\\ \\ \\mathrm{exactly}",
 "span_root": "r_1(\\Delta\\phi) + r_2(\\Delta\\phi) + r_3(\\Delta\\phi) = R(y,t)\\qquad \\Rightarrow\\qquad \\Delta\\phi(y,t)",
 "span_inventory": "2F\\,c_0\\,L_{\\mathrm{cat}}\\int_0^1\\left(\\xi_1+\\xi_2+\\xi_3\\right)dY = Q(t) = \\int_0^t I(t')\\,dt'",
 "span_degenerate": "k_m\\,\\exp\\left(\\dfrac{F\\,U_m^0}{2RT}\\right)\\ \\ \\mathrm{is\\ all\\ the\\ voltage\\ can\\ see}\\qquad (\\dfrac{2RT}{F} = 51\\ \\mathrm{mV})",
 "lm": "\\Delta\\mathbf{p} = -\\left(\\mathbf{J}^{T}\\mathbf{J} + \\lambda\\,\\mathrm{diag}\\left(\\mathbf{J}^{T}\\mathbf{J}\\right)\\right)^{-1}\\mathbf{J}^{T}\\,\\mathbf{r},\\qquad J_{mi} = \\dfrac{\\partial r_m}{\\partial p_i}",
 "tafel_shift": "\\Delta V\\ \\approx\\ \\dfrac{2RT}{F}\\,\\ln\\dfrac{k_{\\mathrm{new}}}{k_{\\mathrm{old}}}\\ \\approx\\ 51\\ \\mathrm{mV}\\times\\ln(\\mathrm{ratio}) = 118\\ \\mathrm{mV\\ per\\ decade}"
}