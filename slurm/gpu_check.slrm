#!/bin/bash
#SBATCH --job-name=gpu_check
#SBATCH --time=00:20:00
#SBATCH --partition=gpu
#SBATCH --gres=gpu:a100:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --output=slurm_logs/gpu_check.%j.out
#SBATCH --error=slurm_logs/gpu_check.%j.err
# ---------------------------------------------------------------------------
# Checks that this account can use an A100 on Grace and that the environment's torch sees it, then times a
# PINN-like workload on CPU (8 cores) and GPU (scripts/hpc_bench.py).
# Submit from the repository root:   mkdir -p slurm_logs; sbatch slurm/gpu_check.slrm
# Cost: at most 0.33 h x (72 SU per A100 hour + 8 cores) = about 27 SUs; usually a few minutes.
# ---------------------------------------------------------------------------
# Environment. Default: HPRC's PyTorch module alone, no venv. It brings Python 3.11, numpy, scipy and torch (CUDA
# build), all the Li-SPAN code needs, and lives under /sw, so it uses none of our 250 000-file scratch quota.
# Check the module name with: module spider PyTorch
# Optional: use an existing venv that ALREADY has a CUDA build of torch (GCCcore/13.2.0 + Python/3.11.5), e.g.
#     sbatch --export=ALL,PINN_VENV=/scratch/user/$USER/ase_env slurm/gpu_check.slrm
module purge
if [ -n "$PINN_VENV" ]; then
    module load GCCcore/13.2.0 Python/3.11.5
    source "$PINN_VENV/bin/activate"
else
    module load GCC/12.3.0 OpenMPI/4.1.5 PyTorch/2.1.2-CUDA-12.1.1
fi

export OMP_NUM_THREADS=8 MKL_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8
cd "$SLURM_SUBMIT_DIR"
echo "host=$(hostname) start=$(date)"
nvidia-smi
python -u scripts/hpc_bench.py
echo "end=$(date)"
